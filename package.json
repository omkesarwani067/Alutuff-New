    "react-router-dom": "^6.26.2",
    "react-slick": "^0.30.2",
    "recharts": "^2.12.7",
    "slick-carousel": "^1.8.1",
    "sweetalert2": "^11.14.0",
    "swiper": "^11.1.12"
  },
  "devDependencies": {
    "react-scripts": "^5.0.1",
    "react-snap": "^1.23.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "postbuild": "react-snap"
  },
  "reactSnap": {
    "source": "build",
    "inlineCss": true,
    "minifyHtml": true,
    "skipThirdPartyRequests": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-setuid-sandbox"
    ],
    "include": [
      "/",
      "/home",
      "/about",
      "/established",
      "/product",
      "/projects",
      "/career",
      "/news",
      "/testReport",
      "/certificates",
      "/contact",
      "/catalogues",
      "/dealer",
      "/blog",
      "/blog/why-acp-panels-are-so-popular-in-modern-architecture",
      "/blog/best-acp-sheets-in-india"
    ]
  }
}
